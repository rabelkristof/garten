// use prisma-8

model User {
  id             Int    @id @default(autoincrement())
  username       String @unique
  email          String @unique
  password       String
  profilePicture String @map("profile_picture")

  projects           Project[]
  tasks              Task[]
  comments           Comment[]
  passwordResetLinks PasswordResetLink[]
  taskAssignments    TaskAssignment[]
  projectMemberships ProjectMembership[]

  @@index([username])
  @@index([email])
}

model Project {
  id                 Int    @id @default(autoincrement())
  name               String
  defaultPermissions Int    @map("default_permissions")
  ownerId            Int    @map("owner_id")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  roles              Role[]
  columns            Column[]
  labels             Label[]
  inviteLinks        InviteLink[]
  projectMemberships ProjectMembership[]
}

model Role {
  id          Int    @id @default(autoincrement())
  name        String
  permissions Int
  projectId   Int    @map("project_id")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectMemberships ProjectMembership[]
}

model Column {
  id        Int    @id @default(autoincrement())
  name      String
  position  Int
  projectId Int    @map("project_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]
}

model Label {
  id        Int    @id @default(autoincrement())
  name      String
  projectId Int    @map("project_id")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labelings Labeling[]
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  columnId    Int     @map("column_id")
  creatorId   Int     @map("creator_id")

  column          Column           @relation(fields: [columnId], references: [id])
  creator         User             @relation(fields: [columnId], references: [id])
  comments        Comment[]
  taskAssignments TaskAssignment[]
  labelings       Labeling[]
}

model Comment {
  id        Int    @id @default(autoincrement())
  content   String
  taskId    Int    @map("task_id")
  creatorId Int    @map("creator_id")

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [creatorId], references: [id])
}

model InviteLink {
  code        String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  isSingleUse Boolean  @map("is_single_use")
  projectId   Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PasswordResetLink {
  code      String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskAssignment {
  taskId Int @map("task_id")
  userId Int @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model ProjectMembership {
  projectId Int @map("project_id")
  userId    Int @map("user_id")
  roleId    Int @map("role_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@id([projectId, userId])
}

model Labeling {
  taskId  Int @map("task_id")
  labelId Int @map("label_id")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}
