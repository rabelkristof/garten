// use prisma-8
model User {
  id                 BigInt              @id @default(autoincrement())
  username           String              @unique
  email              String              @unique
  password           String
  profilePicture     String              @map("profile_picture")

  projects           Project[]
  tasks              Task[]
  comments           Comment[]
  passwordResetLinks PasswordResetLink[]
  taskAssignments    TaskAssignment[]
  projectMemberships ProjectMembership[]

  @@index([username])
  @@index([email])
}

model Project {
  id                 BigInt              @id @default(autoincrement())
  name               String
  defaultPermissions Int                 @map("default_permissions")
  ownerId            BigInt              @map("owner_id")

  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  roles              Role[]
  columns            Column[]
  labels             Label[]
  inviteLinks        InviteLink[]
  projectMemberships ProjectMembership[]

  @@index([ownerId])
}

model Role {
  id                 BigInt              @id @default(autoincrement())
  name               String
  permissions        Int
  projectId          BigInt              @map("project_id")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  projectMemberships ProjectMembership[]

  @@index([projectId])
}

model Column {
  id        BigInt  @id @default(autoincrement())
  name      String
  position  Int
  projectId BigInt  @map("project_id")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks     Task[]

  @@check(expression: sql`position >= 0`, name: "position_check")

  @@index([projectId])
}

model Label {
  id        BigInt     @id @default(autoincrement())
  name      String
  projectId BigInt     @map("project_id")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labelings Labeling[]

  @@index([projectId])
}

model Task {
  id              BigInt           @id @default(autoincrement())
  title           String
  description     String?
  columnId        BigInt           @map("column_id")
  creatorId       BigInt?          @map("creator_id")

  column          Column           @relation(fields: [columnId], references: [id])
  creator         User             @relation(fields: [columnId], references: [id])
  comments        Comment[]
  taskAssignments TaskAssignment[]
  labelings       Labeling[]

  @@index([columnId])
}

model Comment {
  id        BigInt  @id @default(autoincrement())
  content   String
  taskId    BigInt  @map("task_id")
  creatorId BigInt? @map("creator_id")

  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creator   User?   @relation(fields: [creatorId], references: [id])

  @@index([taskId])
}

model InviteLink {
  code        String   @id @onCreate(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  isSingleUse Boolean  @map("is_single_use")
  projectId   BigInt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PasswordResetLink {
  code      String   @id @onCreate(uuid())
  createdAt DateTime @onCreate(now()) @map("created_at")
  userId    BigInt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskAssignment {
  taskId BigInt @map("task_id")
  userId BigInt @map("user_id")

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model ProjectMembership {
  projectId BigInt  @map("project_id")
  userId    BigInt  @map("user_id")
  roleId    BigInt? @map("role_id")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@id([projectId, userId])
}

model Labeling {
  taskId  BigInt @map("task_id")
  labelId BigInt @map("label_id")

  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}
